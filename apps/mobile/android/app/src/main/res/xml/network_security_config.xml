<?xml version="1.0" encoding="utf-8"?>
<!-- Release baseline: no cleartext, and no CA of the app's own.
     The Hub's certificate arrives in the pairing QR and is installed as a
     runtime trust anchor by `HubTlsTrust` (docs: plugin 03 §0), so this file
     has nothing left to pin. A Hub with a publicly signed certificate is
     judged by the system trust store like any other host. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
